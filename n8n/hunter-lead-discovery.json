    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.slackWebhook }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"🔥 *HUNTER n8n Discovery — HOT Lead*\\n\\n*{{ $json.company }}* scored {{ $json.score }}\\n📍 {{ $json.location }}\\n🏭 {{ $json.industry }}\\n🎯 {{ $json.matched_service }}\\n\\n_Auto-discovered via LinkedIn + n8n_\",\n  \"username\": \"HUNTER Intelligence\",\n  \"icon_emoji\": \":hunter:\"\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0021-4000-8000-000000000021",
      "name": "Slack: HOT Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [4120, 40]
    },
    {
      "parameters": {
        "jsCode": "// Build discovery run summary\nconst created = $('HUNTER: Create & Score').all().map(i => i.json).filter(l => l.company);\nconst hot = created.filter(l => l.tier === 'HOT');\nconst high = created.filter(l => l.tier === 'HIGH');\n\nconst summary = {\n  runAt: new Date().toISOString(),\n  totalCreated: created.length,\n  hotLeads: hot.length,\n  highLeads: high.length,\n  companies: created.map(l => `${l.company} (${l.score} — ${l.tier})`),\n  message: `HUNTER Discovery complete: ${created.length} new leads (${hot.length} HOT, ${high.length} HIGH)`\n};\n\nreturn [{ json: summary }];"
      },
      "id": "a1b2c3d4-0022-4000-8000-000000000022",
      "name": "Discovery Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4360, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.slackWebhook }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"📊 *HUNTER Daily Discovery Report*\\n\\n✅ New leads: {{ $json.totalCreated }}\\n🔥 HOT: {{ $json.hotLeads }}\\n🟠 HIGH: {{ $json.highLeads }}\\n\\n{{ $json.companies.length > 0 ? $json.companies.map(c => '• ' + c).join('\\\\n') : '_No new companies found_' }}\",\n  \"username\": \"HUNTER Intelligence\",\n  \"icon_emoji\": \":bar_chart:\"\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0023-4000-8000-000000000023",
      "name": "Slack: Daily Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [4600, 120]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0024-4000-8000-000000000024",
