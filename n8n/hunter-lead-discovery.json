      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [280, 300]
    },
    {
      "parameters": {
        "jsCode": "// Build industry × location search queries for LinkedIn company discovery\nconst config = $('Config').first().json;\nconst industries = config.industries || [];\nconst locations = config.locations || [];\nconst webhookBody = $input.first().json.body || $input.first().json;\n\n// Webhook can push a single company directly\nif (webhookBody && webhookBody.company && webhookBody.location) {\n  return [{\n    json: {\n      company: webhookBody.company,\n      url: webhookBody.url || '',\n      industry: webhookBody.industry || 'Industrial Manufacturing',\n      location: webhookBody.location,\n      employeeCount: webhookBody.employeeCount || 50,\n      decisionMaker: webhookBody.decisionMaker || 'Plant Manager',\n      source: 'webhook',\n      skipApify: true\n    }\n  }];\n}\n\n// Otherwise build Apify search queries\nconst queries = [];\nfor (const industry of industries) {\n  for (const location of locations) {\n    queries.push({\n      json: {\n        searchQuery: `${industry} companies in ${location}`,\n        industry,\n        location,\n        source: 'apify',\n        skipApify: false\n      }\n    });\n  }\n}\n\nreturn queries;"
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Build Search Queries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-skip",
              "leftValue": "={{ $json.skipApify }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Webhook or Scheduled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Loop Queries",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1000, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/{{ $('Config').first().json.apifyActorId }}/runs?token={{ $('Config').first().json.apifyToken }}&waitForFinish=120",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"search\": \"{{ $json.searchQuery }}\",\n  \"maxResults\": {{ $('Config').first().json.maxResultsPerQuery }},\n  \"location\": \"{{ $json.location }}\"\n}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Apify: LinkedIn Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1240, 420]
    },
    {
      "parameters": {
        "url": "=https://api.apify.com/v2/datasets/{{ $json.data.defaultDatasetId }}/items?token={{ $('Config').first().json.apifyToken }}&clean=true&format=json",
        "options": {}
      },
      "id": "a1b2c3d4-0009-4000-8000-000000000009",
      "name": "Apify: Fetch Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1480, 420]
    },
    {
      "parameters": {
        "jsCode": "// Normalize Apify LinkedIn company results into HUNTER lead format\nconst queryMeta = $('Loop Queries').first().json;\nconst items = $input.all().map(i => i.json);\n\n// Apify may return array in single item or multiple items\nlet companies = [];\nif (items.length === 1 && Array.isArray(items[0])) {\n  companies = items[0];\n} else if (items.length === 1 && items[0].name) {\n  companies = items;\n} else {\n  companies = items.flat();\n}\n\nconst normalized = companies\n  .filter(c => c && (c.name || c.companyName || c.title))\n  .map(c => {\n    const name = c.name || c.companyName || c.title || '';\n    const location = c.location || c.headquarters || c.city || queryMeta.location || 'Unknown';\n    const industry = c.industry || queryMeta.industry || 'Industrial Manufacturing';\n    const employeeCount = parseInt(c.employeeCount || c.staffCount || c.companySize || '50', 10) || 50;\n    const url = c.website || c.url || c.companyUrl || '';\n    const linkedinUrl = c.linkedinUrl || c.url || c.profileUrl || '';\n\n    return {\n      json: {\n        company: name.trim(),\n        url: url.startsWith('http') ? url : (url ? `https://${url}` : ''),\n        location: typeof location === 'string' ? location : JSON.stringify(location),\n        industry,\n        employeeCount,\n        decisionMaker: 'Plant Manager',\n        notes: `Auto-discovered via LinkedIn/n8n. Query: \"${queryMeta.searchQuery}\". LinkedIn: ${linkedinUrl}`,\n        source: 'linkedin-apify'\n      }\n    };\n  })\n  .filter(c => c.json.company.length > 1);\n\nif (normalized.length === 0) {\n  return [{ json: { _empty: true, searchQuery: queryMeta.searchQuery } }];\n}\n\nreturn normalized;"
      },
      "id": "a1b2c3d4-0010-4000-8000-000000000010",
      "name": "Normalize Companies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1720, 420]
    },
    {
      "parameters": {
        "jsCode": "// Pass through webhook-pushed single lead\nconst item = $input.first().json;\nreturn [{ json: { ...item, source: item.source || 'webhook' } }];"
      },
      "id": "a1b2c3d4-0011-4000-8000-000000000011",
      "name": "Format Webhook Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 160]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "a1b2c3d4-0012-4000-8000-000000000012",
      "name": "Merge All Leads",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1960, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-empty",
              "leftValue": "={{ $json._empty }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notEquals"
              }
            },
            {
              "id": "cond-company",
              "leftValue": "={{ $json.company }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0013-4000-8000-000000000013",
      "name": "Has Company?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2200, 300]
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.hunterApiUrl }}/leads",
        "options": {}
      },
      "id": "a1b2c3d4-0014-4000-8000-000000000014",
      "name": "Get Existing Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2440, 200]
    },
    {
      "parameters": {
        "jsCode": "// Deduplicate discovered companies against existing HUNTER leads\nconst existing = $('Get Existing Leads').all().flatMap(i => {\n  const data = i.json;\n  return Array.isArray(data) ? data : [data];\n});\n\nconst existingNames = new Set(\n  existing\n    .filter(l => l && l.company)\n    .map(l => l.company.toLowerCase().trim())\n);\n\nconst discovered = $('Has Company?').all().map(i => i.json);\nconst newLeads = discovered.filter(lead => {\n  const name = (lead.company || '').toLowerCase().trim();\n  return name && !existingNames.has(name);\n});\n\nif (newLeads.length === 0) {\n  return [{ json: { _summary: true, newCount: 0, skippedCount: discovered.length, message: 'No new leads — all duplicates' } }];\n}\n\nreturn newLeads.map(lead => ({ json: lead }));"
      },
