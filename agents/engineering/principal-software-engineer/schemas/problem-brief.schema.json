{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem-brief.schema.json",
  "title": "ProblemBrief",
  "type": "object",
  "required": ["problem_id", "title", "problem_statement", "success_criteria", "tier"],
  "properties": {
    "problem_id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "problem_statement": { "type": "string", "minLength": 10 },
    "proposed_solution": { "type": "string", "description": "Pre-baked solution if any — not treated as constraint" },
    "tier": { "type": "string", "enum": ["T0", "T1", "T2", "T3"] },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "measurable"],
        "properties": {
          "id": { "type": "string", "pattern": "^SC-[0-9]+$" },
          "description": { "type": "string" },
          "measurable": { "type": "boolean" },
          "metric": { "type": "string" }
        }
      }
    },
    "stakeholders": { "type": "array", "items": { "type": "string" } },
    "blast_radius": {
      "type": "object",
      "properties": {
        "teams": { "type": "array", "items": { "type": "string" } },
        "services": { "type": "array", "items": { "type": "string" } },
        "users_affected": { "type": "string" }
      }
    },
    "repo_path": { "type": "string" },
    "system_context": { "type": "string" }
  }
}
