{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commitment-map.schema.json",
  "title": "CommitmentMap",
  "type": "object",
  "required": ["context_id", "items"],
  "properties": {
    "context_id": { "type": "string" },
    "sprint_goal": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "owner", "points", "priority"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "owner": { "type": "string" },
          "points": { "type": "number" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" }
        }
      }
    },
    "total_points": { "type": "number" }
  }
}
