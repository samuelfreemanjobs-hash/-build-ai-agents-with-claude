{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "management-context.schema.json",
  "title": "ManagementContext",
  "type": "object",
  "required": ["context_id", "team_name", "output_type", "tier", "team_members"],
  "properties": {
    "context_id": { "type": "string" },
    "team_name": { "type": "string" },
    "output_type": { "type": "string", "enum": ["sprint-plan", "status-report", "one-on-one", "blocker-triage", "executive-summary"] },
    "tier": { "type": "string", "enum": ["T0", "T1", "T2", "T3"] },
    "sprint": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "start_date": { "type": "string" },
        "end_date": { "type": "string" },
        "goal": { "type": "string" }
      }
    },
    "team_members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "level": { "type": "string" },
          "pto_days": { "type": "number", "default": 0 }
        }
      }
    },
    "backlog": { "type": "array", "items": { "type": "object" } }
  }
}
