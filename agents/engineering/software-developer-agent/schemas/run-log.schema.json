{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-log.schema.json",
  "title": "DevRunLog",
  "type": "object",
  "required": ["run_id", "product_id", "status", "started_at", "task_id", "tier"],
  "properties": {
    "run_id": { "type": "string" },
    "product_id": { "type": "string", "const": "software-developer-agent" },
    "task_id": { "type": "string" },
    "task_title": { "type": "string" },
    "tier": { "type": "string", "enum": ["T0", "T1", "T2", "T3"] },
    "status": {
      "type": "string",
      "enum": ["running", "completed", "halted", "failed"]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage_id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string" },
          "duration_ms": { "type": "integer" },
          "skills_loaded": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "files_changed": { "type": "integer" },
    "verification_status": { "type": "string" },
    "review_score": { "type": "integer" },
    "halts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cause": { "type": "string" },
          "stage": { "type": "string" },
          "message": { "type": "string" },
          "fix_path": { "type": "string" }
        }
      }
    }
  }
}
