{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification-report.schema.json",
  "title": "VerificationReport",
  "type": "object",
  "required": ["run_id", "overall_status", "tests", "lint", "security"],
  "properties": {
    "run_id": { "type": "string" },
    "overall_status": { "type": "string", "enum": ["PASS", "FAIL", "HALT"] },
    "tests": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIP"] },
        "command": { "type": "string" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "skipped": { "type": "integer" },
        "duration_seconds": { "type": "number" },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test": { "type": "string" },
              "message": { "type": "string" },
              "file": { "type": "string" }
            }
          }
        }
      }
    },
    "lint": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "tool": { "type": "string" },
        "errors": { "type": "integer" },
        "warnings": { "type": "integer" },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "severity": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FAIL"] },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "description"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["critical", "high", "medium", "low"]
              },
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "description": { "type": "string" },
              "rule": { "type": "string" }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIP"] },
        "vulnerabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "package": { "type": "string" },
              "version": { "type": "string" },
              "severity": { "type": "string" },
              "advisory": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
