<?xml version="1.0" encoding="UTF-8"?>
<!--
  ENVIRONMENTAL GATES ONLY.
  This file contains no orchestration logic, no behavioral rules, and no
  decision criteria. Behavior lives in system-prompt.md. If a change here
  would alter what the agent DOES rather than the limits it operates
  WITHIN, it belongs in system-prompt.md instead.
-->
<config version="2.0.0" agent="ai-proposals-agent">

  <models>
    <primary id="claude-opus-4-5" role="narrative,extraction,evaluation"/>
    <fallback id="claude-sonnet-4-5" role="all" trigger="primary_unavailable"/>
    <!-- VERIFY_BEFORE_USE: confirm model IDs against current API listing -->
  </models>

  <limits>
    <max_tool_output_tokens>25000</max_tool_output_tokens>
    <max_context_tokens>180000</max_context_tokens>
    <max_evaluator_cycles>2</max_evaluator_cycles>
    <max_rfp_source_pages>150</max_rfp_source_pages>
    <case_studies_per_proposal>3</case_studies_per_proposal>
    <min_relevance_score>0.55</min_relevance_score>
    <executive_summary_word_range min="300" max="400"/>
  </limits>

  <paths>
    <run_log>.ai/data/proposal-runs.jsonl</run_log>
    <knowledge_base>./kb/</knowledge_base>
    <cost_tables>./kb/cost-tables/</cost_tables>
    <certifications>./kb/certifications.json</certifications>
    <case_studies>./kb/case-studies/</case_studies>
    <schemas>./schemas/</schemas>
    <output>./out/</output>
  </paths>

  <data_source_grading>
    <!-- Ceiling on confidence assignable to a source class. -->
    <source class="operator_verified_record" max_grade="A"/>
    <source class="operator_historical_proposal" max_grade="B"/>
    <source class="third_party_rate_index" max_grade="B"/>
    <source class="public_web" max_grade="C"/>
    <source class="model_inference" max_grade="F" usable="false"/>
  </data_source_grading>

  <gates>
    <gate name="cost_table_coverage" on_fail="halt"/>
    <gate name="certification_expiry" on_fail="mark_gap"/>
    <gate name="schema_validation" on_fail="halt"/>
    <gate name="run_log_write" on_fail="halt"/>
    <gate name="page_limit" on_fail="critical_defect"/>
  </gates>

  <observability>
    <log_level>info</log_level>
    <emit_stage_timings>true</emit_stage_timings>
    <emit_token_counts>true</emit_token_counts>
    <emit_skill_loads>true</emit_skill_loads>
    <redact_client_names_in_log>true</redact_client_names_in_log>
  </observability>

  <retention>
    <!-- RFP source documents are frequently NDA-covered. -->
    <rfp_source_ttl_days>30</rfp_source_ttl_days>
    <run_log_ttl_days>730</run_log_ttl_days>
    <use_for_model_training>false</use_for_model_training>
  </retention>

</config>
