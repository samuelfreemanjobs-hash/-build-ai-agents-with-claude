{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c4-model.schema.json",
  "title": "C4Model",
  "type": "object",
  "required": ["model_id", "view", "context", "containers"],
  "properties": {
    "model_id": { "type": "string" },
    "view": { "type": "string", "enum": ["as-is", "to-be"] },
    "context": {
      "type": "object",
      "required": ["system_name", "description", "users", "external_systems"],
      "properties": {
        "system_name": { "type": "string" },
        "description": { "type": "string" },
        "users": { "type": "array", "items": { "type": "object" } },
        "external_systems": { "type": "array", "items": { "type": "object" } },
        "diagram": { "type": "string" }
      }
    },
    "containers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "technology", "responsibility"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "technology": { "type": "string" },
          "responsibility": { "type": "string" },
          "type": { "type": "string", "enum": ["service", "database", "queue", "gateway", "external"] },
          "source_ref": { "type": "string" }
        }
      }
    },
    "components": { "type": "array", "items": { "type": "object" } }
  }
}
