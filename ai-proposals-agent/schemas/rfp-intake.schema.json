{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freeman-intel.local/schemas/rfp-intake.schema.json",
  "title": "RfpIntake",
  "type": "object",
  "required": ["client", "scope", "mandatory_requirements", "submission", "risk_assessment"],
  "properties": {
    "client": {
      "type": "object",
      "required": ["company_name", "industry"],
      "properties": {
        "company_name": { "type": "string" },
        "industry": { "type": "string" },
        "pain_points": { "type": "array", "items": { "type": "string" } },
        "strategic_priorities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "services": { "type": "array", "items": { "type": "string" } },
        "geography": { "type": "array", "items": { "type": "string" } },
        "volume": {
          "type": "object",
          "properties": {
            "value": { "type": "string" },
            "unit": { "type": "string" },
            "source_ref": { "type": "string" }
          }
        },
        "start_date": { "type": "string", "format": "date" }
      }
    },
    "mandatory_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "description", "mandatory"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "mandatory": { "type": "boolean", "const": true },
          "rfp_section_ref": { "type": "string" }
        }
      }
    },
    "evaluation_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "factor": { "type": "string" },
          "weight_pct": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" }
        }
      }
    },
    "submission": {
      "type": "object",
      "required": ["due_date"],
      "properties": {
        "due_date": { "type": "string", "format": "date-time" },
        "format": { "type": "string" },
        "required_sections": { "type": "array", "items": { "type": "string" } },
        "page_limit": { "type": "integer" },
        "word_limit": { "type": "integer" }
      }
    },
    "decision_factors": {
      "type": "object",
      "properties": {
        "incumbent": { "type": "string" },
        "budget_signals": { "type": "array", "items": { "type": "string" } },
        "red_flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "risk_assessment": {
      "type": "object",
      "required": ["level", "concerns", "information_gaps"],
      "properties": {
        "level": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "concerns": { "type": "array", "items": { "type": "string" } },
        "information_gaps": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
