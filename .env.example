# The Architect runtime — Samuel Freeman / Freeman Intelligence

# Primary: Claude (The Architect agent, factory, build-agent) — REQUIRED
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Secondary: Gemini (benchmarking, alternate drafts, multimodal — optional)
GEMINI_API_KEY=your-gemini-key-here

# Hostinger website (freemanintelligence.com) — local only, never commit
HOSTINGER_DOMAIN=freemanintelligence.com
HOSTINGER_SFTP_HOST=ftp.freemanintelligence.com
HOSTINGER_SFTP_USER=your-ftp-username
HOSTINGER_SFTP_PASSWORD=your-ftp-password
HOSTINGER_SFTP_PORT=21

# WordPress on Hostinger (optional — if site is WordPress)
# HOSTINGER_WP_URL=https://freemanintelligence.com/wp-admin
# HOSTINGER_WP_USER=admin
# HOSTINGER_WP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Hostinger API (optional — VPS/advanced hosting only)
# HOSTINGER_API_TOKEN=your-hostinger-api-token

# ── Ops portal integrations (ESP · KDP · Stripe) ──
# ESP: convertkit | beehiiv
# ESP_PROVIDER=convertkit
# CONVERTKIT_API_SECRET=your-convertkit-api-secret
# BEEHIIV_API_KEY=your-beehiiv-api-key
# BEEHIIV_PUBLICATION_ID=pub_xxxxxxxx

# Amazon KDP — export sales CSV from KDP Reports, set path for daily sync
# KDP_CSV_PATH=/path/to/kdp-sales.csv

# Stripe — backend revenue (cohort checkout)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # for ops/api/stripe-webhook.php

# Optional: lock Hostinger sync endpoint
# OPS_SYNC_TOKEN=random-long-token

# Override metrics month for Stripe (default: current UTC month)
# METRICS_MONTH=2026-09

# Gmail one-time ingestion (Kennedy/Kern email swipe)
# See agents/the-architect/GMAIL-INGEST.md for setup
# GOOGLE_CREDENTIALS_PATH=/path/to/credentials.json
