# AutoBorder Comply configuration
AUTOBORDER_ENV=development
AUTOBORDER_USE_MOCK_SAP=true

# Neo4j AuraDB (optional — in-memory graph used when unset)
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# SAP S/4HANA (optional — mock data used when unset)
SAP_ASHOST=
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=
SAP_PASSWORD=

# OpenAI for messy spreadsheet extraction (optional — heuristic fallback when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Insurance MGU integration (stub in MVP)
INSURANCE_MGU_API_URL=
INSURANCE_MGU_API_KEY=
